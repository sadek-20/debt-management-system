// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  OWNER
}

enum Currency {
  USD
  SOS
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum DebtStatus {
  ACTIVE
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  EVC
  ZAAD
  EDAHAB
  BANK
}

//////////////////////////////////////////////////////
// BUSINESS
//////////////////////////////////////////////////////

model Business {
  id        String  @id @default(cuid())
  name      String
  ownerName String?

  phone   String  @unique
  email   String? @unique
  address String?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  currency  Currency @default(USD)

  language String @default("so")

  timezone String @default("Africa/Mogadishu")

  whatsappNumber String?

  logoUrl String?

  // Relations
  users User[]

  customers     Customer[]
  debts         Debt[]
  subscriptions Subscription[]
  payments      Payment[]

  @@map("businesses")
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(cuid())

  businessId String

  fullName String

  phone String  @unique
  email String? @unique

  password String

  role UserRole @default(OWNER)

  lastLoginAt DateTime?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@map("users")
}

//////////////////////////////////////////////////////
// CUSTOMER
//////////////////////////////////////////////////////

model Customer {
  id String @id @default(cuid())

  businessId String

  fullName String
  phone    String
  address  String?
  note     String?

  statementToken String @unique @default(cuid())

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  debts Debt[]

  @@index([businessId])
  @@index([phone])
  @@map("customers")
}

//////////////////////////////////////////////////////
// DEBT
//////////////////////////////////////////////////////

model Debt {
  id String @id @default(cuid())

  businessId String
  customerId String

  debtNumber String @unique

  totalAmount     Decimal @db.Decimal(12, 2)
  paidAmount      Decimal @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal @db.Decimal(12, 2)

  status DebtStatus @default(ACTIVE)

  debtDate DateTime  @default(now())
  dueDate  DateTime?

  note String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items    DebtItem[]
  payments Payment[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@map("debts")
}

//////////////////////////////////////////////////////
// DEBT ITEM
//////////////////////////////////////////////////////

model DebtItem {
  id String @id @default(cuid())

  debtId String

  description String

  quantity   Decimal @default(1) @db.Decimal(10, 2)
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("debt_items")
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id String @id @default(cuid())

  businessId String
  debtId     String

  amount Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod

  transactionReference String?
  note                 String?

  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  debt     Debt     @relation(fields: [debtId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([debtId])
  @@index([paymentDate])
  @@map("payments")
}

//////////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////////

model Subscription {
  id String @id @default(cuid())

  businessId String

  plan SubscriptionPlan

  status SubscriptionStatus

  amount Decimal @db.Decimal(12, 2)

  startsAt DateTime

  trialEndsAt DateTime?

  endsAt DateTime

  graceEndsAt DateTime?

  paymentReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([status])
  @@map("subscriptions")
}
